# 复制为 .env 后按需修改；所有配置项见 src/device_agent/config.py

# --- LLM (必填才能使用对话/意图识别) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# GEMINI_THINKING_LEVEL=low

# --- 服务 ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# 写入 Agent Card 的对外地址（部署到其他机器时改成实际可访问的地址）
PUBLIC_BASE_URL=http://localhost:8000
# 设置后除 /health 与 Agent Card 外的接口都需要 Authorization: Bearer <API_TOKEN>
# API_TOKEN=change-me

# --- 设备事件流（默认 Redis Streams，服务启动时 Redis 必须可用）---
EVENT_STORE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
# 仅测试/临时调试时可改用进程内实现: EVENT_STORE_BACKEND=memory

# --- 数据库（默认 SQLite；生产推荐 PostgreSQL）---
DATABASE_URL=sqlite+aiosqlite:///./data/device_agent.db
# DATABASE_URL=postgresql+asyncpg://device_agent:<POSTGRES_APP_PASSWORD>@localhost:5432/device_agent
# PostgreSQL 中 device_agent 角色的密码：docker compose 与 postgres 测试用例都会读取
POSTGRES_APP_PASSWORD=

# --- 测试（可选，以下为默认值）---
# TEST_REDIS_URL=redis://localhost:6379/15
# TEST_POSTGRES_DSN=postgresql://device_agent:<password>@localhost:5432/postgres

# --- 多模态意图识别 ---
INTENT_MONITOR_ENABLED=true
INTENT_SCAN_INTERVAL_SECONDS=10
INTENT_MIN_CONFIDENCE=0.6
